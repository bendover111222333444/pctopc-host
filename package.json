{
  "name": "pctopc-host",
  "version": "1.0.1",
  "description": "A app using WebRTC to give remote computer access.",
  "main": "main.js",
  "type": "commonjs",
  "author": "Bendover111222333444",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
      "@nut-tree-fork/nut-js": "^4.2.6",
      "ffmpeg-static": "^5.3.0",
      "mux.js": "^6.3.0"
  },
  "build": {
      "appId": "com.bendover.pctopc",
      "extraMetadata": {
        "description": "pctopc-host"
      },
      "win": {
          "target": "portable",
          "icon": "assets/goofyIcon.png"
      },
    "extraResources": [
        {
            "from": "node_modules/ffmpeg-static/ffmpeg.exe",
            "to": "ffmpeg.exe"
        }
    ],
    "asarUnpack": [
        "**/node_modules/@nut-tree-fork/**",
        "**/node_modules/ffmpeg-static/**",
        "**/node_modules/@ffmpeg-installer/**"
    ]
  }
}